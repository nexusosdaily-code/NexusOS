  "scripts": {
    "dev:client": "vite dev --port 5000",
    "predev": "fuser -k 5000/tcp 2>/dev/null; fuser -k 5001/tcp 2>/dev/null; sleep 3; fuser -k 5000/tcp 2>/dev/null; fuser -k 5001/tcp 2>/dev/null; sleep 1; true",
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "audit": "node scripts/pre-publish-audit.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:preloads": "tsx scripts/check-preloads.ts",
    "check:system-band": "tsx scripts/check-system-band-literal.ts",
    "check:vitest-setup": "tsx scripts/check-vitest-setup-files.ts",
    "test:constitution": "npx vitest run server/constitution_seal.test.ts",
    "check:types": "tsc --noEmit",
    "check:unwired-handlers": "tsx scripts/check-unwired-handlers.ts",
    "check:unimported-handlers": "tsx scripts/check-unimported-handlers.ts",
    "check:probe-eviction-guard": "tsx scripts/check-probe-eviction-guard.ts",
