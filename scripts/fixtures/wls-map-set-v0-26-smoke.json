  {"name":"Delete only the last matching value","program":"map.deleteLastValue","inputs":{"map":{"entries":[["a","x"],["b","y"],["c","x"]]},"value":"x"},"expect":{"value":{"entries":[["a","x"],["b","y"]]}}},
  {"name":"Absent last match preserves empty key","program":"map.deleteLastValue","inputs":{"map":{"entries":[["","x"]]},"value":"y"},"expect":{"value":{"entries":[["","x"]]}}},
