    {"name":"Identical keys are unchanged","program":"map.swapValues","inputs":{"map":{"entries":[["","Ψ"]]},"first":"","second":""},"expect":{"value":{"entries":[["","Ψ"]]}}},
    {"name":"Toggle removes middle member and canonicalizes","program":"set.toggle","inputs":{"set":{"entries":[["b","x"],["a","y"],["c","z"]]},"value":"a"},"expect":{"value":{"entries":[["b",""],["c",""]]}}},
    {"name":"Toggle appends absent member","program":"set.toggle","inputs":{"set":{"entries":[["b","x"]]},"value":"Ψ"},"expect":{"value":{"entries":[["b",""],["Ψ",""]]}}},
    {"name":"Toggle empty-string member into empty Set","program":"set.toggle","inputs":{"set":{"entries":[]},"value":""},"expect":{"value":{"entries":[["",""]]}}}
  ]
