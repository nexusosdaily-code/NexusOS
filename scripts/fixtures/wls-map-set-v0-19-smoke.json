  {"name":"Set member moves first with empty payloads","program":"set.moveToFront","inputs":{"set":{"entries":[["b","x"],["a","y"]]},"value":"a"},"expect":{"value":{"entries":[["a",""],["b",""]]}}},
  {"name":"Empty set remains empty","program":"set.moveToFront","inputs":{"set":{"entries":[]},"value":""},"expect":{"value":{"entries":[]}}}
